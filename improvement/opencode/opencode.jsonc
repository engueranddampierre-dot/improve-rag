// Config OpenCode : EdenAI (mail d'Adrian) + RAG Maude expose en serveur MCP.
// A copier/fusionner dans ~/.config/opencode/opencode.jsonc
// Premiere utilisation : lancer `opencode`, puis /connect, chercher EdenAI,
// coller la cle API.
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "edenai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "EdenAI",
      "options": {
        "baseURL": "https://api.edenai.run/v3",
      },
      "models": {
        "deepseek/deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
        },
      },
    },
  },
  // Le RAG comme serveur MCP : l'agent decide lui-meme quand interroger
  // l'index (retrieval "tire" par le modele, vs "pousse" dans generate.py).
  // Prerequis : Qdrant lance (docker) et la collection indiquee indexee.
  // ATTENTION (non teste) : mcp-server-qdrant utilise ses propres noms de
  // vecteurs FastEmbed ; il se peut qu'il ne lise pas la collection
  // maude_manual creee par rag-system (vecteur anonyme). Dans ce cas, creer
  // une collection dediee avec QDRANT_AUTO_CREATE ou adapter l'indexation.
  "mcp": {
    "qdrant-maude": {
      "type": "local",
      "command": ["uvx", "mcp-server-qdrant"],
      "environment": {
        "QDRANT_URL": "http://localhost:6333",
        "COLLECTION_NAME": "maude_manual",
        "EMBEDDING_MODEL": "sentence-transformers/all-MiniLM-L6-v2",
      },
    },
  },
}
