***
***	<comment from="gemini-3-flash-preview">
***	The implementation is simplified and optimized by replacing the 'owise' attribute with sort-based pattern matching. By using the NzNat sort for the second argument in the recursive equation, the matching engine can more efficiently distinguish between the base case (zero) and the recursive case (non-zero), while also providing better type safety for the remainder operation.
***	</comment>
***

fmod EUCLIDEAN is
  protecting NAT .
  op $gcd : Nat Nat -> Nat .
  var M : Nat .
  var N : NzNat .
  eq $gcd(M, 0) = M .
  eq $gcd(M, N) = $gcd(N, M rem N) .
endfm