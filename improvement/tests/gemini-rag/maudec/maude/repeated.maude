***
***	<comment from="gemini-3-flash-preview">
***	The efficiency of the `normalize` function is improved by overloading the operator to take an additional `Float` argument. This allow the `norm` (and its underlying `sqrt` and multiplications) to be calculated exactly once per vector and bound to a variable, replacing the three redundant calculations in the original implementation. The semantics are preserved, and the implementation remains within the permitted notation of the provided excerpts.
***	</comment>
***

fmod REPEATED is
	protecting FLOAT .

	sort Vector .

	op <_,_> : Float Float -> Vector [ctor] .

	op norm : Vector -> Float .
	op normalize : Vector -> Vector .
	op normalize : Vector Float -> Vector .

	vars X Y N : Float .
	var V : Vector .

	eq norm(< X, Y >) = sqrt(X * X + Y * Y) .
	eq normalize(V) = normalize(V, norm(V)) .
	eq normalize(< X, Y >, N) =
		if N =/= 0.0 then
			< X / N, Y / N >
		else
			< X, Y >
		fi .
endfm