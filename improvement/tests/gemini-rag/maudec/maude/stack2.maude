***
***	<comment from="gemini-3-flash-preview">
***	The code has been refined for clarity and conciseness while maintaining the original signatures and semantics. In the STACK module, variables and operator definitions are organized and the 'empty?' logic is simplified. In the NAT2-STACK module, multiple operators are declared in a single 'ops' statement for brevity, and the 'merge' function utilizes the 'owise' attribute to concisely handle stacks with fewer than two elements. The implementation remains efficient, utilizing Maude's pattern matching to handle stack operations in constant or linear time as appropriate.
***	</comment>
***

fmod STACK{X :: TRIV} is
  sort Stack{X} .
  op mt : -> Stack{X} [ctor] .
  op push : X$Elt Stack{X} -> Stack{X} [ctor] .
  op pop : Stack{X} -> Stack{X} .
  op top : Stack{X} ~> X$Elt .
  op empty? : Stack{X} -> Bool .
  var S : Stack{X} .
  var E : X$Elt .
  eq pop(mt) = mt .
  eq pop(push(E, S)) = S .
  eq top(push(E, S)) = E .
  eq empty?(mt) = true .
  eq empty?(S) = false [owise] .
endfm

fmod NAT2-STACK is
  pr STACK{Nat} .
  vars N M : Nat .
  var S : Stack{Nat} .
  ops topIncr incr merge : Stack{Nat} -> Stack{Nat} .
  eq topIncr(mt) = mt .
  eq topIncr(push(N, S)) = push(s N, S) .
  eq incr(mt) = mt .
  eq incr(push(N, S)) = push(s N, incr(S)) .
  eq merge(push(N, push(M, S))) = push(N + M, S) .
  eq merge(S) = S [owise] .
endfm