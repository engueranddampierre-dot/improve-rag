***
***	<comment from="gemini-3-flash-preview">
***	The STACK module's implementation has been refined for clarity and efficiency by grouping operator and variable declarations. The 'empty?' function was simplified using explicit pattern matching for the constructors ('mt' and 'push'), which avoids the overhead of the 'owise' attribute and ensures more direct evaluation logic. The original signatures and the safe implementation of 'pop' and 'top' (including kind-level partiality for 'top') have been preserved, while the 'NAT-STACK' module remains a concise instantiation of the generic module.
***	</comment>
***

fmod STACK{X :: TRIV} is
  sort Stack{X} .
  op mt : -> Stack{X} [ctor] .
  op push : X$Elt Stack{X} -> Stack{X} [ctor] .
  op pop : Stack{X} -> Stack{X} .
  op top : Stack{X} ~> X$Elt .
  op empty? : Stack{X} -> Bool .
  var E : X$Elt .
  var S : Stack{X} .
  eq pop(mt) = mt .
  eq pop(push(E, S)) = S .
  eq top(push(E, S)) = E .
  eq empty?(mt) = true .
  eq empty?(push(E, S)) = false .
endfm

fmod NAT-STACK is
  pr STACK{Nat} .
endfm