***
***	<comment from="gemini-2.5-flash">
***	To improve efficiency, the repeated computation of `(M quo N)` in the recursive step has been factored out into a new auxiliary operation `eeuclidAux`. This ensures that `(M quo N)` is calculated only once per recursive call, rather than three times. A new variable `Q` is introduced for this quotient. The function signatures of the original `eeuclid` operations are preserved, and a new signature is added for the internal helper `eeuclidAux`.
***	</comment>
***

fmod INT-FUNS is
 pr INT .

 vars N M U1 V1 U2 V2 : Int .
 var Q : Int .

 *** Extended Eclidean algorithm
 sort EuclidResult .
 op euc : Int Int Int -> EuclidResult [ctor] .

 op eeuclid : Int Int -> EuclidResult .
 op eeuclid : Int Int Int Int Int Int -> EuclidResult .

 *** Helper to avoid recomputing M quo N multiple times
 op eeuclidAux : Int Int Int Int Int Int Int -> EuclidResult .

 eq eeuclid(M, N) = eeuclid(M, 1, 0, N, 0, 1) .
 eq eeuclid(M, U1, V1, 0, U2, V2) = euc(M, U1, V1) .
 eq eeuclid(M, U1, V1, N, U2, V2) = eeuclidAux(M quo N, M, U1, V1, N, U2, V2) .

 eq eeuclidAux(Q, M, U1, V1, N, U2, V2) = eeuclid(N, U2, V2, M - Q * N, U1 - Q * U2, V1 - Q * V2) .
endfm