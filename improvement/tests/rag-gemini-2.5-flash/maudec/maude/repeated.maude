***
***	<comment from="gemini-2.5-flash">
***	To simplify and improve efficiency, I've refactored the `normalize` operation. The original code calculated `norm(< X, Y >)` multiple times. The improved version introduces an auxiliary operator `normalizeWithNorm` to compute the norm only once and pass it as an argument, thus avoiding redundant calculations while preserving the original function signatures of `norm` and `normalize`. The semantics are unchanged.
***	</comment>
***

fmod REPEATED is
    protecting FLOAT .
    
    sort Vector .
    
    op <_,_> : Float Float -> Vector [ctor] .
        
    op norm : Vector -> Float .
    op normalize : Vector -> Vector .
    
    --- Auxiliary operator to pass the pre-computed norm and avoid re-evaluation.
    op normalizeWithNorm : Float Vector -> Vector .
    
    vars X Y : Float .
    var N : Float .
    
    eq norm(< X, Y >) = sqrt(X * X + Y * Y) .
    
    --- The normalize function now computes the norm once and passes it to the helper.
    eq normalize(V:Vector) = normalizeWithNorm(norm(V:Vector), V:Vector) .
    
    --- Helper function rules
    eq normalizeWithNorm(0.0, < X, Y >) = < X, Y > .
    eq normalizeWithNorm(N, < X, Y >) = < X / N, Y / N > when N =/= 0.0 .
endfm