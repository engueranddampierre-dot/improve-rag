***
***	<comment from="gemini-3-flash-preview">
***	The implementation is simplified by delegating the truth table logic to the built-in logical AND operator (_and_) from the BOOL module. This approach reduces the rule set to a single equation per operator, leveraging Maude's internal performance optimizations for Boolean operations while strictly preserving the original function signatures and commutativity.
***	</comment>
***

fmod TRUTH-TABLE is
  protecting BOOL .
  op and : Bool Bool -> Bool .
  op andc : Bool Bool -> Bool [comm] .
  vars A B : Bool .
  eq and(A, B) = A and B .
  eq andc(A, B) = A and B .
endfm