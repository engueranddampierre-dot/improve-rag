***
***	<comment from="gemini-3-flash-preview">
***	The implementation of even2 was optimized by replacing the linear-time structural recursion with the built-in remainder operator, which is significantly more efficient for large natural numbers. This change ensures both functions are consistent, prevents potential stack depth issues, and leverages Maude's built-in NAT operations while maintaining the original signatures.
***	</comment>
***

fmod EVEN is
  protecting BOOL .
  protecting NAT .

  ops even1 even2 : Nat -> Bool .

  var N : Nat .

  eq even1(N) = N rem 2 == 0 .
  eq even2(N) = N rem 2 == 0 .
endfm