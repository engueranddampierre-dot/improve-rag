***
***	<comment from="gemini-3-flash-preview">
***	The code has been simplified and its efficiency improved by adding the 'comm' attribute to the 'add' operation. This reduces the number of equations required for 'add' while preserving its semantics through Maude's built-in support for commutativity. The implementation of 'isFloat' is already efficient due to the 'owise' attribute. The 'nat2float' function remains as a linear recursive definition to adhere to the restriction of not introducing notation (such as built-in conversion functions or helper operations) not present in the original code or provided excerpts.
***	</comment>
***

fmod WRAPPERS is
	protecting INT .
	protecting FLOAT .

	sort Foo .

	op int : Int -> Foo [ctor] .
	op float : Float -> Foo [ctor] .

	op square : Foo -> Foo .
	op isFloat : Foo -> Bool .
	op getFloat : Foo ~> Float .
	op nat2float : Nat -> Float .
	op add : Foo Foo -> Foo [comm] .

	vars N N1 N2 : Int .
	vars F F1 F2 : Float .
	var K : Nat .
	var O : Foo .

	eq square(int(N)) = int(N * N) .
	eq square(float(F)) = float(F * F) .

	eq isFloat(float(F)) = true .
	eq isFloat(O) = false [owise] .

	eq getFloat(float(F)) = F .

	eq nat2float(0) = 0.0 .
	eq nat2float(s K) = 1.0 + nat2float(K) .

	eq add(int(N1), int(N2)) = int(N1 + N2) .
	eq add(float(F1), float(F2)) = float(F1 + F2) .
	eq add(int(N1), float(F1)) = float(nat2float(N1) + F1) .
endfm