***
***	<comment from="gemini-3-flash-preview">
***	The implementation is improved by reducing redundant calculations of the quotient 'M quo N' during each step of the recursive algorithm. By introducing an overloaded version of the 'eeuclid' operator that takes an additional argument for the quotient, we ensure it is computed only once per recursive step, significantly improving performance for large integers where division is costly. The semantics and original function signatures are preserved, and the base-case matching for '0' is maintained as a prioritized pattern.
***	</comment>
***

fmod INT-FUNS is
  pr INT .

  vars M N U1 V1 U2 V2 Q : Int .

  sort EuclidResult .
  op euc : Int Int Int -> EuclidResult [ctor] .

  op eeuclid : Int Int -> EuclidResult .
  op eeuclid : Int Int Int Int Int Int -> EuclidResult .
  op eeuclid : Int Int Int Int Int Int Int -> EuclidResult .

  eq eeuclid(M, N) = eeuclid(M, 1, 0, N, 0, 1) .

  eq eeuclid(M, U1, V1, 0, U2, V2) = euc(M, U1, V1) .

  eq eeuclid(M, U1, V1, N, U2, V2) = 
     eeuclid(M, U1, V1, N, U2, V2, M quo N) .

  eq eeuclid(M, U1, V1, N, U2, V2, Q) = 
     eeuclid(N, U2, V2, M - Q * N, U1 - Q * U2, V1 - Q * V2) .
endfm