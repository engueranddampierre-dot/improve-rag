***
***	<comment from="gemini-3-flash-preview">
***	The original code contained multiple ways to perform sort membership checks. I have simplified the logic by using the built-in membership operator `::` consistently across all predicate functions. This reduces the number of equations and improves clarity while maintaining efficiency. The implementation of `isFoo2` and `isPositive` now follows the concise pattern of `isFoo1`. The variable declarations have also been consolidated for simplicity, and strictly positive integers are correctly identified using the `NzNat` (non-zero natural) sort in accordance with the original semantics.
***	</comment>
***

fmod SORTS-TEST is
  protecting INT .

  sorts Foo Bar .
  subsort Foo < Bar .

  op f : -> Foo [ctor] .
  op g : -> Bar [ctor] .

  var B : Bar .
  var I : Int .

  op isFoo1 : Bar -> Bool .
  eq isFoo1(B) = B :: Foo .

  op isFoo2 : Bar -> Bool .
  eq isFoo2(B) = B :: Foo .

  op isPositive : Int -> Bool .
  eq isPositive(I) = I :: NzNat .
endfm