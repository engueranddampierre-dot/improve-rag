***
***	<comment from="gemini-3-flash-preview">
***	The original implementation of the 'minimum' function relied on a conditional equation and commutative matching. When the condition 'M <= N' fails, the Maude engine must attempt to swap the arguments to find a match. By replacing this with a single equation using the 'if_then_else_fi' expression, we improve efficiency because a match is always found on the first attempt, and the branching logic is handled by a built-in polymorphic operator. This preserves the original signature and semantics while simplifying the execution path.
***	</comment>
***

fmod MINIMUM is
  protecting NAT .

  op minimum : Nat Nat -> Nat [comm] .

  vars M N : Nat .

  eq minimum(M, N) = if M <= N then M else N fi .
endfm