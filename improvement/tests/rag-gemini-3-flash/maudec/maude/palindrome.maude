***
***	<comment from="gemini-3-flash-preview">
***	The original code is simplified by reducing redundant variables and streamlining the 'owise' equation. Replacing the structural pattern 'S1 L S2' with a simple variable 'L' improves efficiency by avoiding unnecessary decomposition during the fallback match. The recursive 'S L S' pattern remains the most effective way to leverage Maude's associative-identity matching for list processing, ensuring palindromes of all lengths are correctly and efficiently identified.
***	</comment>
***

fmod PALINDROME is
  protecting BOOL .
  sorts Symbol List .
  subsort Symbol < List .
  ops a e i o u : -> Symbol [ctor] .
  op nil : -> List [ctor] .
  op __ : List List -> List [ctor assoc id: nil] .
  op palindrome : List -> Bool .
  var S : Symbol .
  var L : List .
  eq palindrome(nil) = true .
  eq palindrome(S) = true .
  eq palindrome(S L S) = palindrome(L) .
  eq palindrome(L) = false [owise] .
endfm