***
***	<comment from="gemini-3-flash-preview">
***	The original Peano-recursive definition of the power function is inefficient for large exponents because Maude must represent the exponents as Peano terms, resulting in O(N) rewrite steps. The implementation is improved by using binary recursion (exponentiation by squaring), which reduces the complexity to O(log N). This approach utilizes the division (/), comparison (<), conditional (if-then-else-fi), and otherwise ([owise]) constructs provided in the manual excerpts, while maintaining the original function signature and ensuring efficiency for the Nat sort.
***	</comment>
***

fmod MAIN is
	protecting INT .

	op f : Nat Nat -> Nat .

	vars X N : Nat .

	eq f(X, 0) = 1 .
	eq f(X, N) = if (N / 2) * 2 < N then X * f(X * X, N / 2) else f(X * X, N / 2) fi [owise] .
endfm